# --- 目标芯片 ---
CONFIG_IDF_TARGET="esp32c3"
# 注:ESP32-C3 无 PSRAM,故不设 CONFIG_SPIRAM。

# --- Flash ---
# FoloToy AI Passport 当前产品/固件基线使用 8MB Flash。
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# 固定 8MB 镜像头，关闭 detect，便于 idf.py merge-bin。
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=n
# 默认模板只保留 NVS、PHY data 和占用剩余空间的 factory app；用户可按需修改。
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- 控制台:USB-Serial-JTAG(C3 原生 USB,GPIO18/19)---
# 不用 UART0:其默认 TX=GPIO21 与本板背光引脚冲突。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- LVGL ---
CONFIG_LV_COLOR_DEPTH_16=y
# 20 ms display refresh period targets up to 50 FPS when rendering and SPI
# transfer complete within the same budget.
CONFIG_LV_DEF_REFR_PERIOD=20
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
# 压缩字形的解压器。assets/fonts/generated 下的 5 个字体都由 lv_font_conv 以
# --bpp 4 生成，即 font_dsc.bitmap_format = LV_FONT_FMT_TXT_COMPRESSED。
# 关掉它不会编译失败，只会让 lv_font_get_bitmap_fmt_txt() 对每个字形返回 NULL：
# 屏幕上一个字都不显示，而 LVGL 的告警又因 LV_USE_LOG 关闭被编译掉，完全无声。
# 这里必须为 y，新增压缩字体时也一并检查本项。
CONFIG_LV_USE_FONT_COMPRESSED=y
# LVGL 内置 malloc 池大小(KB)。它是独立静态区、不与系统堆共享,配大了会白白占用 RAM。
# 本 demo UI 简单,24KB 足够;若自建复杂界面出现绘制卡死/看门狗,调大此值。
CONFIG_LV_MEM_SIZE_KILOBYTES=24

# --- 系统 ---
CONFIG_FREERTOS_HZ=1000

# --- Bluetooth LE ---
# 关掉:本应用没有任何 BLE 消费方。上游模板启用 BLE 是为了它的 demo 菜单,
# 而本应用已用自建界面取代那个菜单(见 main/CMakeLists.txt 的说明)。
# 关掉的价值:BLE 与 Wi-Fi 同时启用会拉起软件共存(CONFIG_ESP_COEX_SW_COEXIST_ENABLE),
# 在无 PSRAM 的 C3 上这是要从本就紧张的内部内存里再切一块。后续做 Opus 时需要把
# 每一 KB 都留给音频缓冲,所以不用就先关。
# ★ 若将来采用 BLE/BLUFI 蓝牙配网,必须把这一段整体恢复(见
#   docs/development/engineering/wifi-provisioning.md),并重新核算内存预算。

# --- TLS / HTTPS(小智激活用)---
# 激活要向 https://api.tenclass.net 发请求,必须开证书校验。
# 证书包根证书编译进 Flash 只读区,不占 RAM;开启的代价是 Flash 体积,而本镜像
# 在 app 分区里仍有大量余量,不构成约束。
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

# 非对称内容长度保持 ESP-IDF 默认(In 16KB / Out 4KB)。
# 曾尝试把入站缓冲压到 8KB,但实测两点:(1) 已存在的 sdkconfig 会覆盖 sdkconfig.defaults,
# 改这里并不会生效;(2) 服务端证书链的握手记录本就有数 KB,16KB 才是安全值。
# 真正的省内存时机是音频通路接入后——那时再连同 Opus 缓冲一起重新核算,而不是现在
# 为了 8KB 去赌一个更紧的握手缓冲。
