# --- 目标芯片 ---
CONFIG_IDF_TARGET="esp32c3"
# 注:ESP32-C3 无 PSRAM,故不设 CONFIG_SPIRAM。

# --- Flash ---
# FoloToy AI Passport 当前产品/固件基线使用 8MB Flash。
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# 固定 8MB 镜像头，关闭 detect，便于 idf.py merge-bin。
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=n
# 默认模板只保留 NVS、PHY data 和占用剩余空间的 factory app；用户可按需修改。
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- 控制台:USB-Serial-JTAG(C3 原生 USB,GPIO18/19)---
# 不用 UART0:其默认 TX=GPIO21 与本板背光引脚冲突。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- LVGL ---
CONFIG_LV_COLOR_DEPTH_16=y
# 20 ms display refresh period targets up to 50 FPS when rendering and SPI
# transfer complete within the same budget.
CONFIG_LV_DEF_REFR_PERIOD=20
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
# 中文字幕用自生成的 cyber_font_cjk（assets/fonts/generated，Noto Sans SC 完整
# 常用汉字子集），不需要 LVGL 内置的思源黑体 CJK 子集（其约 700 常用字实测仍大量
# 缺字成方框；且内置字体会额外占用约 1MB flash）。
# 缺字必须可见：占位框打开，缺字画方框而不糊成空白。关占位框只掩盖缺陷、不修复
# 覆盖，见 docs/development/engineering/lvgl-chinese-fonts.md。
CONFIG_LV_USE_FONT_PLACEHOLDER=y
# 文本编码 UTF-8：服务器字幕是合法 UTF-8，必须按 UTF-8 解码而非 ASCII。
CONFIG_LV_TXT_ENC_UTF8=y
# 压缩字形的解压器。assets/fonts/generated 下的 5 个字体都由 lv_font_conv 以
# --bpp 4 生成，即 font_dsc.bitmap_format = LV_FONT_FMT_TXT_COMPRESSED。
# 关掉它不会编译失败，只会让 lv_font_get_bitmap_fmt_txt() 对每个字形返回 NULL：
# 屏幕上一个字都不显示，而 LVGL 的告警又因 LV_USE_LOG 关闭被编译掉，完全无声。
# 这里必须为 y，新增压缩字体时也一并检查本项。
CONFIG_LV_USE_FONT_COMPRESSED=y
# LVGL 内置 malloc 池大小(KB)。它是独立静态区、不与系统堆共享,配大了会白白占用 RAM。
# 本 demo UI 简单,24KB 足够;若自建复杂界面出现绘制卡死/看门狗,调大此值。
CONFIG_LV_MEM_SIZE_KILOBYTES=24

# --- 系统 ---
CONFIG_FREERTOS_HZ=1000

# --- Bluetooth LE（蓝牙配网）---
# 本应用只在【配网期间】启用 BLE：cyber_prov 起 NimBLE + BLUFI 广播，收到 Wi-Fi
# 凭证并存进 NVS 后，cyber_prov_stop() 会把整栈拆掉、把 RAM 还给系统。
# 因此下面的 BLE 内存开销是"配网时的临时开销"，不是常驻开销——这是无 PSRAM 的 C3
# 上必须的取舍：常驻 BLE 会与 Wi-Fi 软件共存抢内部内存，而本应用同时还要跑
# Opus 编解码与 LVGL（见 cyber_audio.c 的内存账）。
#
# ★ 恢复本段时已同步更新 docs/development/engineering/wifi-provisioning.md 的内存说明。
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
# BLUFI：手机侧"蓝牙配网-FoloToy AI PASSPORT"小程序使用的协议。
CONFIG_BT_NIMBLE_BLUFI_ENABLE=y
# 只做单连接 peripheral（广播 + 被连接），不需要 central/observer，
# 关掉它们能省下对应的 host 缓冲。
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_HOST_BASED_PRIVACY=n
# 不把 BLE 绑定信息落盘：本设备每次配网都是全新会话，持久化只会占 NVS。
CONFIG_BT_NIMBLE_NVS_PERSIST=n

# C3 有硬件 MPI 加速。不加这一项，3072 位 DH 会退化成软件实现（官方注释实测约 12 秒），
# 配网协商会长到像卡死。
# 注：这里刻意【不】开 CONFIG_MBEDTLS_DHM_C——本实现走 PSA 的 FFDH（见
# cyber_prov_security.c），不需要旧版 mbedtls DHM，开了只会白白带上 DHE 的 TLS 密码套件。
CONFIG_MBEDTLS_HARDWARE_MPI=y

# --- 密码学：为蓝牙配网改用软件 AES ---
# 实测问题：配网时 BLUFI 加密失败，报 "esp-aes: Failed to allocate memory"。
# 根因是硬件 AES 的 DMA 路径（components/mbedtls/port/aes/dma/esp_aes_dma_core.c）
# 要用 heap_caps_aligned_alloc 申请【16 字节对齐】的进出缓冲；而配网时（BLE + WiFi
# 扫描同时占用）堆只剩几百字节且高度碎片化，对齐分配直接失败。
# 软件 AES 不申请任何 DMA 缓冲，171 字节的单包加密约 0.1ms，配网与语音场景完全够用；
# 官方 Kconfig 亦注明 240MHz 下硬件 AES 相对软件并无速度优势。
# 代价：TLS 吞吐下降（对本语音助手不构成瓶颈）。这是"无 PSRAM 的 C3 上让配网可用"
# 换来的取舍，若要改回硬件 AES，必须同时解决配网时刻的连续内存问题。
CONFIG_MBEDTLS_HARDWARE_AES=n

# --- 为蓝牙配网腾出连续内存 ---
# 实测问题：配网启动时 BLE 报 "hci inits failed" / btc_init 断言失败。逐步打印堆后
# 定位到：BLE 协议栈初始化需要约 45KB，而进入配网时只剩约 50KB，btc_init 的
# 4KB 任务栈 + 结构体放不下（实测 nimble_port_init 后 free 仅 5588 / largest 5120）。
# 以下三项都是从"减少常驻缓冲"入手挤出空间，不改功能行为。
#
# ★ 只收窄【接收侧】WiFi 缓冲，绝不碰发送侧。
# 实测：握手后堆的最大连续块只剩 12800B，而 Opus 编解码器各需约 20KB 连续内存
# （见 cyber_audio.c），导致编码器打不开 → 采不到音 → 服务端不回复 → 界面卡在
# "思考"。收窄接收缓冲可在 WiFi init 时（堆还很整、未碎片化）少占几 KB，
# 从而给编解码器留出连续的 20KB。
#
# 【为什么只动 RX】曾把发送侧一起削（DYNAMIC_TX 32→16、LWIP TCP 5760→2880），
# 结果上行丢帧率由 4% 飙到 83%：发送缓冲变小后每帧 Opus 的发送阻塞更久，而上行
# 队列只有 4 帧深 → 溢出 → 服务端收不到完整语音并挂断。发送侧是语音链路的硬需求。
#
# WiFi 静态 RX 缓冲：10 → 4（每块约 1.6KB，省约 9.6KB，且是 init 时就占的连续块）。
# 本应用是语音助手，上行 24kbps Opus、下行 24kHz 单声道，不收突发大流量。
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
# WiFi 动态 RX 缓冲上限：32 → 16（按需分配、用完即还；上限决定峰值与碎片形态）。
# 动态缓冲不得小于静态 RX（上面已设为 4，满足）。
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
# 注：DYNAMIC_TX_BUFFER_NUM 与 LWIP TCP 相关项一律保持 IDF 默认，不要动。
# BT 控制器的并发活动数。默认 6 是按"多连接/多广播"预留的，而本应用只做
# 单连接的 BLE peripheral（配网），2 已够用；控制器 RAM 直接随它增长。
CONFIG_BT_CTRL_BLE_MAX_ACT=2
# NimBLE host 的内存池。默认值是按"多连接 + 高吞吐"给的，单连接配网用不上，
# 而这些池是【整块 calloc】——池越大，越可能因堆已碎片化而分配失败。
#   ACL：默认 24 × ~264B ≈ 6.3KB  →  8 × ~264B ≈ 2.1KB
#   EVT：默认 30 × 70B ≈ 2.1KB     →  12 × 70B ≈ 0.8KB
#   MSYS_1：默认 12 × 256B ≈ 3KB    →  8 × 256B ≈ 2KB
#   MSYS_2：默认 24 × 320B ≈ 7.7KB →  6 × 320B ≈ 1.9KB
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=8
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=12
CONFIG_BT_NIMBLE_TRANSPORT_EVT_DISCARD_COUNT=4
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=8
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=6

# 【实测踩过的坑，勿删】NimBLE 的 host 任务由 esp_nimble_enable() 创建，
# 而那个函数【无条件返回 ESP_OK】——即使 xTaskCreatePinnedToCore 失败被静默吞掉：
#     xTaskCreatePinnedToCore(host_task, "nimble_host", NIMBLE_HS_STACK_SIZE, ...);
#     return ESP_OK;      // 不看返回值
# 后果极其隐蔽：日志照常打印"配网已启动"，但 NimBLE 主机从未运行、从不广播，
# 手机端表现为"搜不到设备"。实测正是如此——当时 largest=3072 而
# BT_NIMBLE_HOST_TASK_STACK_SIZE=4096，只差 1KB。
# 因此：BT_NIMBLE_HOST_TASK_STACK_SIZE 所需的 4KB【连续】内存必须在起 BLE 前留够，
# 下面的收窄就是为了腾出这段连续块，不要为了"省内存"再把它们调回默认值。
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=4096

# --- TLS / HTTPS(小智激活 + 对话)---
# 激活要向 https://api.tenclass.net 发请求,必须开证书校验。
# 证书包根证书编译进 Flash 只读区,不占 RAM;开启的代价是 Flash 体积,而本镜像
# 在 app 分区里仍有大量余量,不构成约束。
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

# api.tenclass.net 的链走 DigiCert 交叉签名(GeoTrust 中间证书由交叉背书的根签发),
# 默认的单锚验证会命中错误的那条信任路径,报 PK verify 0x4290 / CERT_VERIFY_FAILED。
# 该选项(仅 ESP-IDF 6.x 提供)让证书包同时尝试交叉背书的两条根路径,与官方
# xiaozhi-esp32 的 sdkconfig.defaults 对齐。
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y

# 低内存 TLS 配置,对齐官方 defaults(其注释标记为 "# Fix ESP_SSL error")。
# 本板无 PSRAM、单核 C3,音频通路接入后堆很紧:握手期保留整张对端证书 + 静态大
# 缓冲,会在 RSA4096 中间证书验签的峰值内存上失败。动态缓冲 + 不保留对端证书 +
# 关闭重协商,把握手峰值 RAM 压下来,让 Opus/LVGL/WiFi 并存时仍能完成链验证。
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE=n
CONFIG_MBEDTLS_SSL_RENEGOTIATION=n

# 非对称内容长度保持 ESP-IDF 默认(In 16KB / Out 4KB)。
# 曾尝试把入站缓冲压到 8KB,但实测两点:(1) 已存在的 sdkconfig 会覆盖 sdkconfig.defaults,
# 改这里并不会生效;(2) 服务端证书链的握手记录本就有数 KB,16KB 才是安全值。
# 真正的省内存时机是音频通路接入后——那时再连同 Opus 缓冲一起重新核算,而不是现在
# 为了 8KB 去赌一个更紧的握手缓冲。
