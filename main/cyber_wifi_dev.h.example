// main/cyber_wifi_dev.h.example —— 开发期 Wi-Fi 凭证覆盖模板。
//
// 用法：把本文件复制为同目录下的 cyber_wifi_dev.h 并填上真实值。
// cyber_wifi_dev.h 已在 .gitignore 里，不会被提交，也不会被仓库的敏感信息检查扫描。
//
// 一旦该文件存在且 SSID 非空，它的取值【优先于】NVS 中的凭证，
// 这样本地调试不必去改设备的 NVS 内容。
//
// 注意：这是开发便利，不是产品配网方案。正式方案会用配网流程把凭证写进 NVS，
// 到时删掉这个文件即可回到 NVS 优先。
#pragma once

// SSID：1..32 字节。
#define CYBER_WIFI_DEV_SSID "你的WiFi名称"

// 口令：8..63 字节；开放网络留空字符串。
#define CYBER_WIFI_DEV_PASS "你的WiFi密码"
